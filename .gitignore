# Ambientes virtuais
venv/
.venv/
env/
ENV/
.python-version

# Bytecode / build
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Testes e ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Banco gerado a partir dos CSVs (reconstruivel, nao versionar)
data/
*.db
*.sqlite3

# Saidas da coleta (dados gerados, nao versionar)
output/
*.csv
*.xlsx
relatorio_*.md
# Log e resumo da coleta (`--resumo`), gerados no GitHub Actions ou localmente.
coleta/

# Excecao: o snapshot que alimenta o deploy precisa ser versionado, senao a
# API sobe vazia no servidor (o disco do Render e efemero).
!seed/*.csv

# Editores / SO
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Segredos
.env
.env.*
!.env.example
# Contexto local do CLI do Neon: guarda orgId e projectId reais.
.neon
# Secrets locais do Streamlit (no Community Cloud eles ficam so no painel).
.streamlit/secrets.toml

# Pacotes do CLI do Neon (@neon/config), instalados por `neon config init`.
node_modules/
